{
  "name": "@pipou/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --typecheck",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@pipou/tsconfig": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
