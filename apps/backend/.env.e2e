# Config des tests e2e (Cucumber) — base MySQL locale du docker-compose, aucun secret réel.
# Utilisée par `pnpm e2e:api` (via ENV_FILE) et `pnpm test:e2e:cucumber`.
NODE_ENV=test
PORT=3001
API_URL=http://localhost:3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=cardcollect
JWT_SECRET=e2e-only-secret-never-used-elsewhere
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
TEST_USER_EMAIL=e2e-player@pipou.test
TEST_USER_PASSWORD=e2e-player-pass
ADMIN_EMAIL=e2e-admin@pipou.test
ADMIN_PASSWORD=e2e-admin-pass
