# Copier en .env. TypeORM synchronize (réécriture du schéma) n'est actif que sur
# une base locale hors production : une base distante (Aiven) n'est jamais modifiée.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=cardcollect
# Certificat CA Aiven encodé en base64 (vide en local)
DB_SSL_CA_BASE64=
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
JWT_SECRET=CHANGE_ME_SUPER_SECRET_32_CHARS_MIN
IMGBB_API_KEY=
RESEND_API_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
